{
	"name": "mcp",
	"private": true,
	"version": "1.3.0",
	"license": "GPL-3.0",
	"type": "module",
	"scripts": {
		"dev": "vite --mode development",
		"dev:local": "vite --mode localdev",
		"dev:test": "vite --mode test",
		"prod": "vite --mode production",
		"build": "vite build",
		"build:dev": "vite build --mode development",
		"create-user": "bun run scripts/createuser.ts",
		"stripe:reset:customers": "bun run scripts/stripe/reset.ts",
		"stripe:setup:webhooks": "bun run scripts/stripe/setup-webhooks.ts",
		"stripe:webhook": "bun run scripts/stripe/webhook.ts -- --log-level debug --log-exclude ping-pong",
		"import": "bun run import/index.ts",
		"fix": "biome check --write",
		"check": "biome check --error-on-warnings",
		"test:code": "bun test code --isolate",
		"check:ci": "biome ci --error-on-warnings && tsc -b --noEmit && bun run test:code && rm -f *.tsbuildinfo && echo 'no errors'",
		"check:fallow": "fallow --quiet --format json --fail-on-issues",
		"check:fallow:audit": "fallow audit --quiet",
		"db:reset": "bun run scripts/supabase/db.ts reset",
		"db:push:migrations": "bun run scripts/supabase/db.ts push",
		"db:push:secrets": "bun run scripts/supabase/secrets.ts push",
		"db:push:config": "bun run scripts/supabase/config.ts push",
		"db:push:functions": "bun run scripts/supabase/functions.ts push",
		"db:push:all": "bun run scripts/supabase/all.ts push",
		"db:types": "bun run scripts/supabase/types.ts",
		"supabase:restart": "bun run scripts/supabase/restart.ts",
		"lint:sql": "squawk supabase/migrations/*.sql",
		"lint:db": "supabase db lint --remote --level warning --fail-on warning",
		"reset-branch:lovable": "bun run scripts/reset-branch-lovable.ts",
		"preview": "vite preview",
		"docker:start": "docker compose -f .devcontainer/compose.yml up -d --no-recreate",
		"docker:shell": "docker compose -f .devcontainer/compose.yml up -d --no-recreate && docker compose -f .devcontainer/compose.yml exec -it -u agent workspace bash",
		"docker:agent": "docker compose -f .devcontainer/compose.yml up -d --no-recreate && docker compose -f .devcontainer/compose.yml exec -it -u agent workspace agent"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@supabase/supabase-js": "^2.119.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"react": "^18.3.1",
		"react-big-calendar": "^1.19.4",
		"react-colorful": "^5.6.1",
		"react-day-picker": "^9.13.2",
		"react-dom": "^18.3.1",
		"react-icons": "^5.5.0",
		"react-router-dom": "^6.30.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^2.6.0",
		"tailwindcss": "^3.4.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^22.20.1",
		"@types/react": "^18.3.23",
		"@types/react-big-calendar": "^1.16.3",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"autoprefixer": "^10.4.21",
		"fallow": "^3.40.0",
		"lovable-tagger": "^1.1.13",
		"postcss": "^8.5.6",
		"squawk-cli": "^2.40.1",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.8.3",
		"vite": "^5.4.19"
	},
	"trustedDependencies": [
		"squawk-cli"
	]
}
