{
	"name": "mcp",
	"private": true,
	"version": "1.4.0",
	"license": "GPL-3.0",
	"type": "module",
	"scripts": {
		"dev": "vite --mode development",
		"dev:local": "vite --mode localdev",
		"dev:test": "vite --mode test",
		"prod": "vite --mode production",
		"build": "vite build",
		"build:dev": "vite build --mode development",
		"create-user": "bun run scripts/createuser.ts",
		"stripe:reset:customers": "bun run scripts/stripe/reset.ts",
		"stripe:setup:webhooks": "bun run scripts/stripe/setup-webhooks.ts",
		"stripe:webhook": "bun run scripts/stripe/webhook.ts -- --log-level debug --log-exclude ping-pong",
		"import": "bun run import/index.ts",
		"fix": "biome check --write",
		"check": "biome check --error-on-warnings",
		"test:code": "bun test code --isolate",
		"check:ci": "biome ci --error-on-warnings && tsc -b --noEmit && bun run test:code && rm -f *.tsbuildinfo && echo 'no errors'",
		"check:fallow": "fallow --quiet --format json --fail-on-issues",
		"check:fallow:audit": "fallow audit --quiet",
		"db:reset": "bun run scripts/supabase/db.ts reset",
		"db:push:migrations": "bun run scripts/supabase/db.ts push",
		"db:push:secrets": "bun run scripts/supabase/secrets.ts push",
		"db:push:config": "bun run scripts/supabase/config.ts push",
		"db:push:functions": "bun run scripts/supabase/functions.ts push",
		"db:push:all": "bun run scripts/supabase/all.ts push",
		"db:types": "bun run scripts/supabase/types.ts",
		"supabase:restart": "bun run scripts/supabase/restart.ts",
		"lint:sql": "squawk supabase/migrations/*.sql",
		"lint:db": "supabase db lint --remote --level warning --fail-on warning",
		"reset-branch:lovable": "bun run scripts/reset-branch-lovable.ts",
		"preview": "vite preview",
		"docker:start": "docker compose -f .devcontainer/compose.yml up -d --no-recreate",
		"docker:exec": "bun run docker:start && docker compose -f .devcontainer/compose.yml exec -it -u agent workspace",
		"docker:shell": "bun run docker:exec bash",
		"docker:agent": "bun run docker:exec agent",
		"docker:dev": "bun run docker:exec bun run dev",
		"docker:dev:local": "bun run docker:exec bash -lc 'trap \"kill $w $d 2>/dev/null\" INT TERM EXIT; bun run stripe:webhook -- --log-terminal off & w=$!; bun run dev:local & d=$!; wait'"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-collapsible": "^1.2.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@supabase/supabase-js": "^2.119.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"react": "^18.3.1",
		"react-big-calendar": "^1.20.0",
		"react-colorful": "^5.8.1",
		"react-day-picker": "^9.14.0",
		"react-dom": "^18.3.1",
		"react-icons": "^5.7.0",
		"react-router-dom": "^7.18.5",
		"sonner": "^2.0.8",
		"tailwind-merge": "^2.6.1",
		"tailwindcss": "^3.4.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@swc/core": "1.15.11",
		"@types/bun": "^1.4.4",
		"@types/node": "^22.20.5",
		"@types/react": "^18.3.31",
		"@types/react-big-calendar": "^1.16.3",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"autoprefixer": "^10.6.2",
		"fallow": "^3.43.0",
		"lovable-tagger": "^1.3.5",
		"postcss": "^8.5.33",
		"squawk-cli": "^2.72.0",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.8.3",
		"vite": "^6.4.6"
	},
	"trustedDependencies": [
		"@swc/core"
	]
}
