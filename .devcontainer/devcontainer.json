{
	"name": "mcp",
	"dockerComposeFile": "compose.yml",
	"service": "workspace",
	"workspaceFolder": "/workspace",
	"remoteUser": "agent",
	"overrideCommand": false,
	"postCreateCommand": "set -e; mkdir -p \"$HOME\" \"$TMPDIR\" \"$XDG_CONFIG_HOME\" \"$XDG_CACHE_HOME\"",
	"shutdownAction": "stopCompose"
}
